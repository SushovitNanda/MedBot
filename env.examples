# Copy this file to .env and fill in the required values.

# Required API keys
GOOGLE_API_KEY=
GROQ_API_KEY=
API_SECRET_TOKEN=
HF_TOKEN=

# Frontend (must match API_SECRET_TOKEN)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_TOKEN=

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Qdrant: auto | server | local
QDRANT_MODE=auto
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Local ML (ingest + retrieval) — auto uses GPU when PyTorch has CUDA
LOCAL_MODEL_DEVICE=auto
USE_LOCAL_VISION_CAPTION=true
VISION_CAPTION_MODEL=Salesforce/blip-image-captioning-large
VISION_CAPTION_BATCH_SIZE=8

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CLIP_MODEL=openai/clip-vit-base-patch32
CLIP_DIM=512

# Chat LLMs (cloud only)
PRIMARY_LLM=gemini-3.1-flash-lite-preview
SECONDARY_LLM=gemini-2.0-flash
FALLBACK_LLM=llama-3.3-70b-versatile

# PDF figure extraction
INGEST_MIN_IMAGE_PIXELS=3600
PAGE_RENDER_DPI=150
FIGURE_PAGE_MAX_TEXT_CHARS=400
SCANNED_PAGE_TEXT_THRESHOLD=120

# Chunking & retrieval
SECTION_CHUNK_TOKENS=800
SEMANTIC_CHUNK_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
TOP_K_DENSE=15
TOP_K_SPARSE=15
TOP_K_IMAGE=5
TOP_K_FUSED=20
TOP_K_RERANKED=5
MAX_RETRY_COUNT=2
CONFIDENCE_THRESHOLD=0.70

# Hugging Face (Windows)
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Optional Langfuse
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3001
